// Forjio service template — minimal Prisma schema.
//
// Ships with only the outbox plumbing required by ADR-0006. Each product
// adds its own domain models on top. Cross-service models (User, Account,
// etc.) live in Huudis and are referenced by ID only — never replicated.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Transactional outbox — ADR-0006.
/// Every state change that other services may care about writes a row
/// here inside the same transaction as the change itself. A polling
/// worker reads unpublished rows and fans out to HTTP subscribers.
model OutboxEvent {
  id           String   @id // ULID, globally unique (evt_*)
  type         String   // e.g. "locavello.entity.verb.v1"
  accountId    String?  // event scope; null for global events
  aggregateId  String?  // top-level aggregate id (for indexed queries per entity)
  occurredAt   DateTime
  data         Json
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())
  publishedAt  DateTime?
  attempts     Int      @default(0)
  lastError    String?

  @@index([publishedAt, createdAt], name: "ix_outbox_unpublished")
  @@index([accountId, type])
  @@index([aggregateId, type])
  @@map("outbox_events")
}

/// Consumer-side idempotency record — ADR-0006.
/// When this service consumes an event, the handler inserts a row here
/// inside its own transaction. Replay attempts hit the PK unique and
/// exit cleanly.
model ProcessedEvent {
  eventId     String   @id
  processedAt DateTime @default(now())

  @@map("processed_events")
}

/// Operator feature flag — part of the mandatory admin-portal standard
/// (see forjio/documentation/2. Technical/13-Admin-Portal-Standard.md).
///
/// Flipping a flag changes runtime behaviour for EVERY user of this
/// deployment, so it is an operator control behind `adminGuard` — never a
/// customer-portal setting.
///
/// `key` is the primary key on purpose: app code reads flags by key, so a
/// rename is a migration rather than an edit, and there is no surrogate id
/// to drift from the string the code actually uses.
model FeatureFlag {
  key         String   @id
  label       String
  description String?
  enabled     Boolean  @default(false)
  /// 0-100 percentage rollout. NULL means all-or-nothing — distinct from
  /// 0, which means "on, but for nobody yet".
  rollout     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// Huudis user id of whoever last flipped it. Nullable because seeds and
  /// migrations write flags with no human behind them.
  updatedBy   String?
  /// Subjects the flag is ON for regardless of `enabled` — Huudis user
  /// ids and/or email addresses. This is how a pilot ships: off for the
  /// world, on for the named few.
  allowlist   String[] @default([])

  @@map("feature_flags")
}

/// Append-only audit of every feature-flag write. Kept separate from the
/// flag row because `updatedBy`/`updatedAt` only ever answer "who last
/// touched it" — during an incident the question is "what changed, when,
/// and what was it before".
model FeatureFlagAudit {
  id        String   @id // ULID
  key       String
  actor     String?
  at        DateTime @default(now())
  before    Json
  after     Json

  @@index([key, at])
  @@map("feature_flag_audits")
}

// ─── Locavello domain ────────────────────────────────────────────────
//
// The i18n engine. One rule shapes everything here: code owns which keys
// exist + source text + context (flows UP via extract/push); the portal
// owns every non-source translation + releases (flows DOWN via pull).
// Releases are immutable content-hashed snapshots so builds are
// reproducible and any bad copy change reverts to an exact prior state.

/// A localization project — one per product (Mode A / SDK) or per site
/// (Mode B / proxy). Owned by a Huudis workspace. Keys are counted per
/// project for billing — never per locale-copy (that double-dips).
model Project {
  id           String   @id // prj_<ulid>
  accountId    String
  slug         String
  name         String
  sourceLocale String   @default("en")
  /// 'sdk' = Mode A (catalogs committed, zero runtime dependency).
  /// 'proxy' = Mode B (crawler + served translations; the customer
  /// knowingly trades a runtime dependency for five-minute setup —
  /// serving MUST fail open to the source language).
  mode         String   @default("sdk")
  siteUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  locales    ProjectLocale[]
  namespaces Namespace[]
  keys       Key[]
  releases   Release[]
  pages      SitePage[]

  @@unique([accountId, slug])
  @@index([accountId])
  @@map("projects")
}

/// An enabled target locale. BCP-47 tag + explicit fallback chain link
/// (pt-BR → pt → source). Falls back to the source locale, never to a
/// blank string.
model ProjectLocale {
  id        String  @id // loc_<ulid>
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  tag       String
  /// Next tag in the fallback chain; null falls through to the
  /// project's sourceLocale.
  fallback  String?
  rtl       Boolean @default(false)
  enabled   Boolean @default(true)

  @@unique([projectId, tag])
  @@map("project_locales")
}

/// Namespaces are the unit of lazy-loading AND of review policy.
/// reviewPolicy 'gated' (legal, pricing) = no auto-publish, a human
/// approves every translation, always.
model Namespace {
  id           String  @id // ns_<ulid>
  projectId    String
  project      Project @relation(fields: [projectId], references: [id])
  name         String
  reviewPolicy String  @default("standard") // 'standard' | 'gated'

  keys Key[]

  @@unique([projectId, name])
  @@map("namespaces")
}

/// A translatable key. `name` is either a dotted path (new code) or the
/// source text itself (retrofit mode — key === source renders
/// byte-identically with zero translations). The context columns are
/// the whole reason a portal beats a folder of JSON files: they are
/// what a human translator needs in the workbench and exactly what the
/// agent needs in its prompt.
model Key {
  id            String   @id // key_<ulid>
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  namespaceId   String
  namespace     Namespace @relation(fields: [namespaceId], references: [id])
  name          String
  sourceText    String
  description   String?
  screenshotUrl String?
  /// Max display length for the slot (de/fi run ~30% longer than en).
  maxLength     Int?
  /// Declared ICU placeholder names — translations that drop or rename
  /// one are mechanically rejected (the #1 cause of runtime crashes).
  placeholders  Json     @default("[]")
  /// Usage sites [{file, line}] + sibling hints from `extract`.
  context       Json     @default("{}")
  /// Stale — no longer seen by `extract`; kept for history, excluded
  /// from releases and billing counts.
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  translations Translation[]

  @@unique([projectId, namespaceId, name])
  @@index([projectId, archived])
  @@map("keys")
}

/// One (key, locale) translation. ICU MessageFormat, never bare
/// interpolation. status walks missing → machine → needs_review →
/// approved; only approved values enter a release for gated
/// namespaces, machine+ for standard ones.
model Translation {
  id         String   @id // tr_<ulid>
  keyId      String
  key        Key      @relation(fields: [keyId], references: [id])
  locale     String
  value      String
  status     String   @default("machine") // 'machine' | 'needs_review' | 'approved' | 'rejected'
  /// Huudis sub, or 'agent:<model>' for machine passes.
  author     String?
  reviewedBy String?
  /// Why a reviewer rejected it — training signal for the agent.
  rejectedReason String?
  wordCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([keyId, locale])
  @@index([locale, status])
  @@map("translations")
}

/// Immutable published snapshot of (project, locale), identified by
/// content hash. `catalog` is the frozen key→value map `pull` writes
/// into the repo. Never updated, never deleted — rollback is "point at
/// an earlier release", not a mutation.
model Release {
  id          String   @id // rel_<ulid>
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  locale      String
  contentHash String
  catalog     Json
  keyCount    Int
  createdBy   String?
  createdAt   DateTime @default(now())

  @@unique([projectId, locale, contentHash])
  @@index([projectId, locale, createdAt])
  @@map("releases")
}

/// Do-not-translate terms (translation null) and forced translations
/// (locale + translation set) — enforced by `locavello check`, not just
/// advisory. Account-wide when projectId is null.
model GlossaryTerm {
  id          String  @id // gls_<ulid>
  accountId   String
  projectId   String?
  term        String
  locale      String?
  translation String?
  note        String?

  @@unique([accountId, projectId, term, locale])
  @@index([accountId])
  @@map("glossary_terms")
}

/// Cross-project translation memory — the compounding asset and the
/// actual reason this beats 13 separate JSON files. Scoped to the
/// account; exact match via sourceHash (sha256 of normalized source).
model TmEntry {
  id           String   @id // tm_<ulid>
  accountId    String
  projectId    String?
  sourceLocale String
  targetLocale String
  sourceText   String
  sourceHash   String
  targetText   String
  quality      String   @default("approved") // 'approved' | 'machine'
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([accountId, sourceHash, targetLocale])
  @@index([accountId, sourceLocale, targetLocale])
  @@map("tm_entries")
}

/// Mode B: a page discovered on a proxied site. The crawler is just
/// another extractor — its strings land in Key/Translation like any
/// SDK push.
model SitePage {
  id            String    @id // pg_<ulid>
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id])
  path          String
  status        String    @default("discovered") // 'discovered' | 'crawled' | 'error'
  keyCount      Int       @default(0)
  lastCrawledAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([projectId, path])
  @@map("site_pages")
}

/// An agent-translation run (machine pass, Mode B preview, or crawl).
/// Word costs are estimated BEFORE the run and metered after.
model TranslationJob {
  id          String   @id // tj_<ulid>
  accountId   String
  projectId   String?
  locale      String?
  kind        String   // 'machine_pass' | 'preview' | 'crawl'
  status      String   @default("queued") // 'queued' | 'running' | 'done' | 'failed'
  stats       Json     @default("{}")
  error       String?
  requestedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId, status, createdAt])
  @@map("translation_jobs")
}

/// Developer API key (`lv_live_…`, sha256-hashed at rest). The CLI and
/// SDKs authenticate pull/push/extract with these.
model ApiKey {
  id         String    @id // ak_<ulid>
  accountId  String
  name       String
  keyHash    String    @unique
  /// First characters of the plaintext, for display ("lv_live_ab…").
  prefix     String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())

  @@index([accountId])
  @@map("api_keys")
}

/// Metered agent-translation usage — the billing input. `trial` rows
/// draw down the Free tier's one-off 1,000-word allowance; `metered`
/// rows bill from the catentio credit wallet.
model AgentUsage {
  id        String   @id // au_<ulid>
  accountId String
  projectId String?
  jobId     String?
  words     Int
  kind      String   // 'trial' | 'included' | 'metered'
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
  @@map("agent_usage")
}

/// Workspace subscription — absence of a row IS the free tier. Written
/// only by the Plugipay checkout webhook (idempotent on session id).
model BillingSubscription {
  id                        String    @id // bsub_<ulid>
  accountId                 String    @unique
  /// free | starter | pro | scale
  tier                      String    @default("free")
  /// active | past_due | canceled
  status                    String    @default("active")
  plugipayCheckoutSessionId String?
  currentPeriodEnd          DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([plugipayCheckoutSessionId])
  @@map("billing_subscriptions")
}

// ─────────────────────────────────────────────────────────────────────
// Identity roster — thin SSO capture (admin-CRM blind-spot fix, the
// serront ea0babd pattern). NOT an auth table: identity authority stays
// in Huudis; these rows are a display-only cache so the CRM can resolve
// accountId → who. Upserted at sign-in (auth-config `onAuthenticated`)
// and on authenticated requests (middleware/auth.ts, write-throttled
// in-process).
// ─────────────────────────────────────────────────────────────────────

model RosterIdentity {
  id          String             @id // rst_<ulid>
  huudisSub   String             @unique
  email       String
  name        String
  createdAt   DateTime           @default(now())
  lastSeenAt  DateTime           @default(now())
  memberships RosterMembership[]

  @@map("roster_identities")
}

/// One (user, accountId) sighting — a user acts under many workspaces
/// and a workspace has many users. The CRM picks the earliest-created
/// member of an accountId as its best-known contact.
model RosterMembership {
  id         String         @id // rmb_<ulid>
  huudisSub  String
  accountId  String
  createdAt  DateTime       @default(now())
  lastSeenAt DateTime       @default(now())
  identity   RosterIdentity @relation(fields: [huudisSub], references: [huudisSub], onDelete: Cascade)

  @@unique([huudisSub, accountId])
  @@index([accountId])
  @@map("roster_memberships")
}

// ─────────────────────────────────────────────────────────────────────
// Developer-portal surfaces: outbound webhooks + audit trail (the
// serront webhook-subscription + depllo audit patterns).
// ─────────────────────────────────────────────────────────────────────

/// Customer webhook endpoint — receives locavello.* outbox events,
/// delivered by services/outbox-worker.ts with
/// `Locavello-Signature: t=<unix>,v1=<hmac-sha256>`. The whsec_ signing
/// secret is returned ONCE at creation and never listed again.
model WebhookSubscription {
  id        String   @id // whs_<ulid>
  accountId String
  url       String
  secret    String
  /// Event-type allowlist as a JSON string array; ["*"] = everything.
  events    Json     @default("[\"*\"]")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, active])
  @@map("webhook_subscriptions")
}

/// Append-only workspace audit trail (never updated or deleted).
/// Written by lib/audit.ts `recordAudit` from mutating portal routes.
model AuditEvent {
  id         String   @id // aud_<ulid>
  accountId  String // Huudis workspace scope
  actorSub   String // Huudis sub, or 'system'/'apikey:…'
  actorLabel String? // display name/email when known
  action     String // 'project.created' | 'release.published' | …
  targetType String // 'project' | 'translation' | 'release' | …
  targetId   String
  summary    String // human-readable one-liner
  metadata   Json     @default("{}") // never secret values
  createdAt  DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([accountId, action, createdAt])
  @@map("audit_events")
}

/// Per-workspace settings for the embedded catentio assistant. Absent
/// row = auto-apply ON, matching every other product in the family
/// (review mode is the opt-in, not the default).
model AssistantSettings {
  accountId String   @id
  /// May the assistant apply changes itself (true) or does it propose
  /// them as review cards (false)? Mirrored into the delegation
  /// token's write scope on every chat dispatch.
  autoApply Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("assistant_settings")
}
