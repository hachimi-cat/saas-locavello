# Frontend config — copy to .env.local

NEXT_PUBLIC_API_URL=http://localhost:4270
NEXT_PUBLIC_OIDC_ISSUER=https://huudis.com
NEXT_PUBLIC_OIDC_CLIENT_ID=locavello
NEXT_PUBLIC_BRAND_NAME="Locavello"

# Cloudflare Turnstile site key. When set at BUILD time, @forjio/auth-ui
# renders the Turnstile widget on login/signup and sends the token as
# `cf-turnstile-response`; the backend verifies it when
# TURNSTILE_SECRET_KEY is set. Both sides bypass gracefully when unset.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
